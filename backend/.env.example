# Production (Railway): Set ALLOWED_ORIGINS to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# Supports comma-separated origins for preview and production deployments:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Server host and port (Railway provides PORT dynamically)
PORT=8000
HOST=0.0.0.0
ENV=production

# Persistent Volume Database Path (Railway)
# Set CONCERNS_DB_PATH to the mounted volume path on Railway (e.g. /data/concerns.db)
# Defaults to backend/concerns.db for local development if unset.
CONCERNS_DB_PATH=